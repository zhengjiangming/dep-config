@echo off
rem =====================================================================
rem  bat_application offline installer (portable, no environment needed)
rem  Run this file after extracting the package to its final folder,
rem  e.g. D:\bat_application  (path must NOT contain spaces).
rem =====================================================================
setlocal enabledelayedexpansion
cd /d "%~dp0"
call "conf\env.bat"
title bat_application installer
mode con cols=100 lines=45 >nul 2>&1

echo ============================================================
echo   bat_application offline installer
echo   Bundled: JDK17 + JDK21, MySQL, PostgreSQL, Redis, RocketMQ,
echo            Nacos, MinIO, GeoServer, 13 services, mapserver, qrule
echo ============================================================
echo.

rem ------------------------------------------------------------
echo [1/7] System check
ver
echo   ARCH=%PROCESSOR_ARCHITECTURE%   DIR=%APP_HOME%
if not "%PROCESSOR_ARCHITECTURE%"=="AMD64" goto :BAD_ARCH
if not "%APP_HOME: =%"=="%APP_HOME%" goto :BAD_PATH
if not exist "%APP_HOME%\runtime\jdk17\bin\java.exe" goto :BAD_JDK
if not exist "%APP_HOME%\runtime\jdk21\bin\java.exe" goto :BAD_JDK
echo   OK
goto :STEP2
:BAD_ARCH
echo   ERROR: 32-bit Windows is not supported by this package.
pause
exit /b 1
:BAD_PATH
echo   ERROR: install path contains a space. Move this folder to D:\bat_application
pause
exit /b 1
:BAD_JDK
echo   ERROR: runtime\jdk17 or runtime\jdk21 missing, package is incomplete.
pause
exit /b 1

rem ------------------------------------------------------------
:STEP2
echo.
echo [2/7] VC++ runtime for MySQL / PostgreSQL / MinIO on fresh Win7
if not exist "%APP_HOME%\runtime\vc_redist.x64.exe" goto :NO_VCREDIST
echo   Installing, please wait ...
"%APP_HOME%\runtime\vc_redist.x64.exe" /install /quiet /norestart
echo   Done.
goto :STEP3
:NO_VCREDIST
echo   SKIP: runtime\vc_redist.x64.exe not bundled.
echo   If MySQL/PG/MinIO cannot start on a clean Win7, install
echo   VC++ 2015-2022 x64 redistributable, or Win7 UCRT KB2999226, manually.

rem ------------------------------------------------------------
:STEP3
echo.
echo [3/7] Host IP and ports
set "IP="
for /f "tokens=2 delims=:" %%A in ('ipconfig ^| findstr /c:"IPv4"') do if not defined IP set "IP=%%A"
if defined IP set "IP=%IP: =%"
if not defined IP set "IP=127.0.0.1"
set "DEPLOY_HOST=%IP%"
call :ASK DEPLOY_HOST "  IP that other machines use to access this server"
call :ASK INFRA_JDK "  JDK for Nacos/GeoServer/RocketMQ, 17 (Nacos 2.3.3) or 21"
set /p "DEFPORTS=  Use default ports? [Y/n]: "
if /i "%DEFPORTS%"=="n" goto :ASK_PORTS
goto :PORTS_DONE
:ASK_PORTS
call :ASK MYSQL_PORT "  MySQL port"
call :ASK PG_PORT "  PostgreSQL port"
call :ASK REDIS_PORT "  Redis port"
call :ASK MINIO_PORT "  MinIO API port"
call :ASK MQ_NAMESRV_PORT "  RocketMQ NameServer port"
call :ASK MQ_BROKER_PORT "  RocketMQ Broker port"
call :ASK NACOS_PORT "  Nacos port"
call :ASK GEOSERVER_PORT "  GeoServer port"
call :ASK NGINX_PORT "  Nginx port"
:PORTS_DONE

rem ------------------------------------------------------------
echo.
echo [4/7] Accounts
echo   Do not use ^& ^| ^< ^> ^^ or quotes in values.
call :ASK MYSQL_USER "  MySQL user"
call :ASK MYSQL_PWD "  MySQL password"
call :ASK PG_USER "  PostgreSQL user"
call :ASK PG_PWD "  PostgreSQL password"
call :ASK MINIO_USER "  MinIO access key"
call :ASK MINIO_PWD "  MinIO secret key"
call :ASK REDIS_PWD "  Redis password (blank = no auth)"
call :ASK NACOS_USER "  Nacos user (blank = auth disabled)"
call :ASK NACOS_PWD "  Nacos password"

rem ------------------------------------------------------------
:STEP5
echo.
echo [5/7] Write conf\deploy.properties
set "F=%APP_HOME%\conf\deploy.properties"
if exist "%F%" copy /y "%F%" "%F%.bak" >nul
(
echo # generated by install.bat %DATE% %TIME%
echo DEPLOY_HOST=%DEPLOY_HOST%
echo INFRA_JDK=%INFRA_JDK%
echo MYSQL_PORT=%MYSQL_PORT%
echo MYSQL_USER=%MYSQL_USER%
echo MYSQL_PWD=%MYSQL_PWD%
echo PG_PORT=%PG_PORT%
echo PG_USER=%PG_USER%
echo PG_PWD=%PG_PWD%
echo REDIS_PORT=%REDIS_PORT%
echo REDIS_PWD=%REDIS_PWD%
echo MINIO_PORT=%MINIO_PORT%
echo MINIO_USER=%MINIO_USER%
echo MINIO_PWD=%MINIO_PWD%
echo MINIO_DATA_DIR=
echo MQ_NAMESRV_PORT=%MQ_NAMESRV_PORT%
echo MQ_BROKER_PORT=%MQ_BROKER_PORT%
echo NACOS_PORT=%NACOS_PORT%
echo NACOS_NAMESPACE=%NACOS_NAMESPACE%
echo NACOS_GROUP=%NACOS_GROUP%
echo NACOS_PROFILE=prod
echo NACOS_USER=%NACOS_USER%
echo NACOS_PWD=%NACOS_PWD%
echo GEOSERVER_PORT=%GEOSERVER_PORT%
echo NGINX_PORT=%NGINX_PORT%
echo MYSQL_HOST=%DEPLOY_HOST%
echo PG_HOST=%DEPLOY_HOST%
echo REDIS_HOST=%DEPLOY_HOST%
echo MINIO_HOST=%DEPLOY_HOST%
echo MQ_HOST=%DEPLOY_HOST%
echo NACOS_HOST=%DEPLOY_HOST%
echo GEOSERVER_HOST=%DEPLOY_HOST%
echo NGINX_HOST=%DEPLOY_HOST%
echo START_MYSQL=1
echo START_PG=1
echo START_REDIS=1
echo START_MINIO=1
echo START_MQ=1
echo START_NACOS=1
echo START_GEOSERVER=1
echo START_NGINX=1
) > "%F%"
if not exist "%APP_HOME%\conf\mapserver" mkdir "%APP_HOME%\conf\mapserver"
if not exist "%APP_HOME%\conf\qrule" mkdir "%APP_HOME%\conf\qrule"
if not exist "%APP_HOME%\conf\nacos" mkdir "%APP_HOME%\conf\nacos"
if not exist "%APP_HOME%\conf\nginx" mkdir "%APP_HOME%\conf\nginx"
echo   Written: %F%

rem ------------------------------------------------------------
echo.
echo [6/7] Data directory init
set /p "DOINIT=  Initialize MySQL/PostgreSQL data dirs now? [Y/n]: "
if /i "%DOINIT%"=="n" goto :SKIP_INIT
call "%APP_HOME%\bin\0-init.bat" <nul
goto :STEP7
:SKIP_INIT
echo   SKIP: run bin\0-init.bat later.

rem ------------------------------------------------------------
:STEP7
echo.
echo [7/7] Firewall rules
set "PLIST=%MYSQL_PORT%,%PG_PORT%,%REDIS_PORT%,%MINIO_PORT%,9001,%MQ_NAMESRV_PORT%,%MQ_BROKER_PORT%,10909,10911,10912,%NACOS_PORT%,9848,9849,%GEOSERVER_PORT%,%NGINX_PORT%"
netsh advfirewall firewall add rule name="bat_application" dir=in action=allow protocol=TCP localport=%PLIST% >nul 2>&1
if errorlevel 1 (
    echo   WARN: firewall rule not added. Right-click install.bat -^> Run as administrator.
) else (
    echo   OK: TCP ports %PLIST% opened.
)

rem ------------------------------------------------------------
echo.
echo ============================================================
echo  Install finished.
echo    1) config check : bin\1-check.bat
echo    2) start all    : start-all.bat
echo    3) status       : bin\4-status.bat
echo    4) import Nacos configs (after infra is up): bin\5-import-config.bat
echo    5) stop all     : stop-all.bat
echo  Keep this folder together; data is stored in data\, logs in logs\.
echo ============================================================
pause
exit /b 0

rem ------------------------------------------------------------
:ASK
rem %1 = variable name, %2 = prompt
set "OLD=!%~1!"
set /p "NEW=%~2 [!OLD!]: "
if not "%NEW%"=="" set "%~1=%NEW%"
exit /b 0
